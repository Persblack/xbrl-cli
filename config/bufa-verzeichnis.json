  "conversionRules": {
    "_comment": "Vereinfachtes Format: FF/BBB/UUUUP -> Bundeseinheitlich 13-stellig. Format: LLFF0BBBUUUUP wobei LL=Bundesland-Prefix, FF=BuFa-Suffix, BBB(B)=Bezirksnr, UUUU(P)=Unternr+Prüfziffer. Die 0 ist eine fixe Null als Trenner.",

    "standard": {
      "_comment": "Gilt für die meisten Bundesländer (nicht Bayern und NRW)",
      "steps": [
        "Take BuFa 4 digits as LLFF",
        "Take Steuernummer FF/BBB/UUUUP",
        "Ignore the FF from Steuernummer (redundant with BuFa)",
        "Result: LLFF0BBBUUUUP (13 digits)"
      ]
    },

    "nrw": {
      "_comment": "NRW: BuFa 5XXX, Steuernummer XXX/XXXX/XXXP",
      "steps": [
        "Take BuFa 4 digits (5FFF)",
        "Take Steuernummer FFF/BBBB/UUUP",
        "Result: 5FFF0BBBBUUUP (13 digits)"
      ]
    },

    "bayern": {
      "_comment": "Bayern: BuFa 9XXX, Steuernummer XXX/XXX/XXXXXP (3/3/5 format)",
      "steps": [
        "Take BuFa 4 digits (9FFF)",
        "Take Steuernummer FFF/BBB/UUUUUP",
        "Result: 9FFF0BBBUUUUUP (13 digits)"
      ]
    }
  }
